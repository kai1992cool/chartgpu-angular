{
  "name": "chartgpu-angular-workspace",
  "version": "0.0.0",
  "private": false,
  "description": "Unnofficial Angular bindings for ChartGPU — WebGPU-powered high-performance charts",
  "keywords": [
    "angular",
    "chartgpu",
    "react",
    "chart",
    "webgpu",
    "visualization",
    "streaming",
    "typescript"
  ],
  "homepage": "https://kai1992cool.github.io/chartgpu-angular/",
  "repository": {
    "type": "git",
    "url": "https://github.com/kai1992cool/chartgpu-angular.git",
    "directory": "projects/chartgpu-angular"
  },
  "bugs": {
    "url": "https://github.com/kai1992cool/chartgpu-angular/issues"
  },
  "license": "MIT",
  "author": "Naren",
  "scripts": {
    "test": "vitest run",
    "build:version": "node scripts/build-version.mjs",
    "build:all": "node scripts/build-all-versions.mjs",
    "storybook:version": "node scripts/storybook-version.mjs",
    "ci": "npm run build && npm run test && npm run build-storybook",
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --project chartgpu-angular",
    "compodoc": "npx compodoc -p /projects/chartgpu-angular/.storybook/tsconfig.doc.json -s",
    "storybook": "ng run chartgpu-angular:storybook",
    "build-website": "ng build chartgpu-angular && cp ./README.md dist/chartgpu-angular/browser/README.md && cp ./LICENSE dist/chartgpu-angular/LICENSE",
    "serve:ssr:chartgpu-angular": "node dist/chartgpu-angular/server/server.mjs",
    "build-storybook": "ng run chartgpu-angular:build-storybook",
    "patch": "cd projects/chartgpu-angular && npm version patch --depth 9999 && cd ../..",
    "publish-package": "node scripts/publish-angular.mjs",
    "publish": "npm run build && cp ./README.md ./LICENSE dist/chartgpu-angular && cd dist/chartgpu-angular && npm publish"
  },
  "dependencies": {
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/router": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "chartgpu": "^0.4.0",
    "marked": "^18.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.0.0",
    "@analogjs/vitest-angular": "2.0.0",
    "@angular-devkit/build-angular": "^18.2.21",
    "@angular/cli": "^18.2.21",
    "@angular/compiler-cli": "^18.2.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/angular": "^10.6.3",
    "@types/node": "^18.18.0",
    "jsdom": "^26.1.0",
    "ng-packagr": "^18.2.0",
    "storybook": "^10.6.1",
    "typescript": "~5.4.5",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
