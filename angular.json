{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "chartgpu-angular": {
      "projectType": "library",
      "root": "projects/chartgpu-angular",
      "sourceRoot": "projects/chartgpu-angular/src",
      "prefix": "cga",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/chartgpu-angular/ng-package.json"
          }
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "configDir": "projects/chartgpu-angular/.storybook",
            "browserTarget": "chartgpu-angular:build",
            "tsConfig": "projects/chartgpu-angular/.storybook/tsconfig.json",
            "port": 6006,
            "compodoc": false
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "assets": [
              {
                "glob": "README.md",
                "input": "projects/chartgpu-angular",
                "output": "/"
              }
            ],
            "configDir": "projects/chartgpu-angular/.storybook",
            "browserTarget": "chartgpu-angular:build",
            "tsConfig": "projects/chartgpu-angular/.storybook/tsconfig.json",
            "outputDir": "dist/storybook/chartgpu-angular",
            "compodoc": false
          }
        }
      }
    },
    
    "chartgpu-angular-demo": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "projects/chartgpu-angular/src",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/chartgpu-angular-demo",
            "index": "projects/chartgpu-angular/src/index.html",
            "browser": "projects/chartgpu-angular/src/main.ts",
            "polyfills": [],
            "tsConfig": "projects/chartgpu-angular/tsconfig.app.json",
            "assets": [
              {
                "glob": "README.md",
                "input": ".",
                "output": "/"
              }
            ],
            "scripts": [
              "node_modules/@popperjs/core/dist/umd/popper.min.js",
              "node_modules/bootstrap/dist/js/bootstrap.min.js"
            ],
            "styles": [
              "node_modules/bootstrap/dist/css/bootstrap.min.css",
              "projects/chartgpu-angular/src/styles/styles.css"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "packageManager": "npm",
    "analytics": false
  }
}
